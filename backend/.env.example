# Copy to backend/.env (gitignored) and fill in.

# RAW_DATA_DIR defaults to <repo>/data/raw

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=study-assistant
PINECONE_NAMESPACE=default

# AWS Bedrock (credentials come from the standard AWS chain: profile, SSO, or env vars)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5

# API password gate (deployed version)
API_PASSWORD=

# Chunking / hybrid search (defaults shown)
# CHUNK_MAX_TOKENS=450
# CHUNK_OVERLAP_TOKENS=50
# SPARSE_PAGE_TOKENS=150
# HYBRID_ALPHA=0.5
