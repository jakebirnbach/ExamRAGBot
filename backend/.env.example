# Copy to backend/.env (gitignored) and fill in.

# RAW_DATA_DIR defaults to <repo>/data/raw

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=study-assistant
PINECONE_NAMESPACE=default

# AWS Bedrock - Claude via the Anthropic SDK's Bedrock client
BEDROCK_REGION=us-east-1
# Named profile in ~/.aws (an IAM user/role with Bedrock invoke access, never root).
# Deliberately not AWS_PROFILE / AWS_REGION: shell-exported AWS_* variables override .env.
BEDROCK_AWS_PROFILE=
# converse (default): AWS Converse API with Claude Haiku 4.5.
# messages: Anthropic SDK client for current models; set BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
#   once AWS enables Haiku 5.5 on the account.
# BEDROCK_API=converse
# Defaults to us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=
# messages API only - how much the model thinks before answering: low | medium | high
# LLM_EFFORT=low

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5

# API password gate (deployed version)
API_PASSWORD=

# Chunking / hybrid search (defaults shown)
# CHUNK_MAX_TOKENS=450
# CHUNK_OVERLAP_TOKENS=50
# SPARSE_PAGE_TOKENS=150
# HYBRID_ALPHA=0.5
